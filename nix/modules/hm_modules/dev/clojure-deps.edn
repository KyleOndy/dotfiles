;; Global ~/.clojure/deps.edn, installed by clojure.nix.
;;
;; Alias key spelling matters and is not forgiving: tools.deps silently
;; ignores keys it does not recognize, so a typo here produces an alias that
;; resolves without error and adds nothing to the classpath.
;; https://clojure.org/reference/deps_and_cli#_aliases
{:aliases
 {:nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}}}

  :repl/rebel {:extra-deps {com.bhauman/rebel-readline {:mvn/version "0.1.4"}}
               :main-opts ["-m" "rebel-readline.main"]}

  :repl/reveal {:extra-deps {vlaaad/reveal {:mvn/version "1.3.282"}}
                :main-opts ["-m" "vlaaad.reveal" "repl"]}

  ;; https://github.com/seancorfield/deps-new
  :new {:extra-deps {io.github.seancorfield/deps-new {:git/tag "v0.7.0"
                                                      :git/sha "58f2c19"}}
        :exec-fn org.corfield.new/create
        :exec-args {:template "app"}}

  ;; https://github.com/liquidz/antq#clojure-cli
  :outdated {:replace-deps {com.github.liquidz/antq {:mvn/version "2.8.1185"}}
             :main-opts ["-m" "antq.core"]}

  :find-deps {:extra-deps {find-deps/find-deps {:git/url "https://github.com/hagmonk/find-deps"
                                                :git/sha "9bf23a52cb0a8190c9c2c7ad1d796da802f8ce7a"}}
              :main-opts ["-m" "find-deps.core"]}}}
