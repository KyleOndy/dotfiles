{
  "title": "Appliances",
  "uid": "appliances",
  "tags": ["home", "esphome", "power"],
  "description": "The washer, dryer, sump pump and basement dehumidifier, each read from an ESPHome power plug on the iot network that tiger scrapes. Investigation surface for the sump_pump and dehumidifier alert groups and InstanceDown on job esphome.",
  "id": null,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Plug Status",
      "description": "Whether tiger's scrape reaches each plug. Offline for 2 minutes on the sump pump is SumpPumpOffline; for the others, 5 minutes is InstanceDown.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"esphome\"}",
          "instant": true,
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red"
                },
                "1": {
                  "text": "online",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Power Now",
      "description": "Instantaneous draw at each outlet, a 10 s average on the plug. Readings under 3 W show as 0.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "esphome_sensor_value{job=\"esphome\",id=\"power\"}",
          "instant": true,
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Energy, 24h",
      "description": "kWh each outlet used over the last 24 hours. Energy per Day below only shows a day once it has closed.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(esphome_sensor_value{job=\"esphome\",id=\"total_energy\"}[24h])",
          "instant": true,
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Power",
      "description": "Draw per outlet. The sump pump counts as running above 50 W, and SumpPumpRunningLong fires after 10 minutes of it without a break.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "esphome_sensor_value{job=\"esphome\",id=\"power\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "washer"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dryer"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sump-pump"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dehumidifier"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Sump Pump",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Last Run",
      "description": "Time since the pump last drew more than 50 W, looking back 7 days. A long gap in a wet week is worth a look at the pit.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max_over_time(timestamp(esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > 50)[7d:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "over 7 days"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Duty, 1h",
      "description": "Share of the last hour the pump ran. SumpPumpBusy fires above 30%.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > bool 50)[1h:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Runs, 24h",
      "description": "Starts counted from 15 s samples, so a run shorter than one scrape can be missed.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(((esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > bool 50) > (esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} offset 15s > bool 50))[24h:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Runs per Hour",
      "description": "Starts per hour. A few long runs is inflow; dozens of short ones is short cycling from the float or the check valve.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(((esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > bool 50) > (esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} offset 15s > bool 50))[$__interval:15s])",
          "legendFormat": "runs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h"
    },
    {
      "type": "row",
      "title": "Dehumidifier",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Last Run",
      "description": "Time since the compressor last ran (above 150 W), looking back 7 days.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max_over_time(timestamp(esphome_sensor_value{job=\"esphome\",host=\"dehumidifier\",id=\"power\"} > 150)[7d:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "over 7 days"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Duty, 24h",
      "description": "Share of the last 24 hours the compressor ran.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((esphome_sensor_value{job=\"esphome\",host=\"dehumidifier\",id=\"power\"} > bool 150)[24h:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Outdoor Dew Point, 48h",
      "description": "Outdoor dew point averaged over 48 hours, from birdnet-go's yr.no weather on cogsworth. Above 12 C, DehumidifierIdle fires if the compressor has not run in those 48 hours.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((WITH (t = weather_temperature_celsius{job=\"birdnet-go\"}, g = ln(weather_humidity_percentage{job=\"birdnet-go\"} / 100) + 17.62 * t / (243.12 + t)) 243.12 * g / (17.62 - g))[2d:15m])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "blue",
                "value": 12
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Compressor Duty and Outdoor Dew Point",
      "description": "Share of each hour the compressor ran, against outdoor dew point. A humid stretch with no duty is what DehumidifierIdle catches.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((esphome_sensor_value{job=\"esphome\",host=\"dehumidifier\",id=\"power\"} > bool 150)[$__interval:15s])",
          "legendFormat": "duty"
        },
        {
          "refId": "B",
          "expr": "WITH (t = weather_temperature_celsius{job=\"birdnet-go\"}, g = ln(weather_humidity_percentage{job=\"birdnet-go\"} / 100) + 17.62 * t / (243.12 + t)) 243.12 * g / (17.62 - g)",
          "legendFormat": "dew point"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dew point"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "min"
              },
              {
                "id": "max"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "1h"
    },
    {
      "type": "row",
      "title": "Outlets",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
