{
  "title": "Appliances",
  "uid": "appliances",
  "tags": ["home", "esphome", "power"],
  "description": "The washer, dryer, sump pump, and the HVAC humidifier with the condensate pump that drains it, each read from an ESPHome power plug on the iot network that tiger scrapes. Investigation surface for the sump_pump and condensate_pump alert groups and InstanceDown on job esphome.",
  "id": null,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Plug Status",
      "description": "Whether tiger's scrape reaches each plug. Offline for 2 minutes on the sump pump is SumpPumpOffline; for the others, 5 minutes is InstanceDown.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"esphome\"}",
          "instant": true,
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red"
                },
                "1": {
                  "text": "online",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Power Now",
      "description": "Instantaneous draw at each outlet, a 10 s average on the plug. Readings under 3 W show as 0.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "esphome_sensor_value{job=\"esphome\",id=\"power\"}",
          "instant": true,
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Energy, 24h",
      "description": "kWh each outlet used over the last 24 hours. Energy per Day below only shows a day once it has closed.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(esphome_sensor_value{job=\"esphome\",id=\"total_energy\"}[24h])",
          "instant": true,
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Power",
      "description": "Draw per outlet. The sump pump counts as running above 50 W, and SumpPumpRunningLong fires after 10 minutes of it without a break.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "esphome_sensor_value{job=\"esphome\",id=\"power\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "washer"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dryer"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sump-pump"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "condensate-pump"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Sump Pump",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Last Run",
      "description": "Time since the pump last drew more than 50 W, looking back 7 days. A long gap in a wet week is worth a look at the pit.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max_over_time(timestamp(esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > 50)[7d:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "over 7 days"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Duty, 1h",
      "description": "Share of the last hour the pump ran. SumpPumpBusy fires above 30%.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > bool 50)[1h:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Runs, 24h",
      "description": "Starts counted from 15 s samples, so a run shorter than one scrape can be missed.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(((esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > bool 50) > (esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} offset 15s > bool 50))[24h:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Runs per Hour",
      "description": "Starts per hour. A few long runs is inflow; dozens of short ones is short cycling from the float or the check valve.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(((esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} > bool 50) > (esphome_sensor_value{job=\"esphome\",host=\"sump-pump\",id=\"power\"} offset 15s > bool 50))[$__interval:15s])",
          "legendFormat": "runs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h"
    },
    {
      "type": "row",
      "title": "Humidifier and Condensate Pump",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Running Now",
      "description": "Decoded from the plug's single power reading. Both are single speed and its only loads: fan alone 37.5-39.2 W, pump alone 57 W, both 89-95.5 W. A pump cycle lasts 10-20 s, so Last Pump Run says more about the pump.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "WITH (p = esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"}) (p > bool 20) * (p < bool 50) + (p > bool 75)",
          "legendFormat": "humidifier fan",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"} > bool 50",
          "legendFormat": "condensate pump",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off",
                  "color": "transparent"
                },
                "1": {
                  "text": "running",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last Pump Run",
      "description": "Time since the plug last read above 50 W, the pump running, looking back 7 days.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max_over_time(timestamp(esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"} > 50)[7d:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "over 7 days"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Pump Runs, 24h",
      "description": "Pump starts above 50 W, counted from 15 s samples, so a run shorter than one scrape can be missed.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(((esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"} > bool 50) > (esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"} offset 15s > bool 50))[24h:15s])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Humidifier Runtime, 24h",
      "description": "Time in the last 24 hours the humidifier's fan ran, decoded as in Running Now.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((WITH (p = esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"}) (p > bool 20) * (p < bool 50) + (p > bool 75))[24h:15s]) * 86400",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Outdoor Dew Point, 12h",
      "description": "Outdoor dew point averaged over 12 hours, from birdnet-go's yr.no weather on cogsworth. Below 0 C, HumidifierIdle fires if nothing on the plug ran in those 12 hours.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((WITH (t = weather_temperature_celsius{job=\"birdnet-go\"}, g = ln(weather_humidity_percentage{job=\"birdnet-go\"} / 100) + 17.62 * t / (243.12 + t)) 243.12 * g / (17.62 - g))[12h:15m])",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "text",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
      "title": "Running",
      "description": "When each one ran, decoded as in Running Now. A block is marked running if any 15 s sample in it was, so a 10-20 s pump cycle still shows at wide time ranges.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((WITH (p = esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"}) (p > bool 20) * (p < bool 50) + (p > bool 75))[$__interval:15s])",
          "legendFormat": "humidifier fan"
        },
        {
          "refId": "B",
          "expr": "max_over_time((esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"} > bool 50)[$__interval:15s])",
          "legendFormat": "condensate pump"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off",
                  "color": "transparent"
                },
                "1": {
                  "text": "running",
                  "color": "purple"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "condensate pump"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "off",
                        "color": "transparent"
                      },
                      "1": {
                        "text": "running",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Humidifier Minutes and Pump Runs per Hour",
      "description": "Humidifier fan minutes and pump starts per hour, against outdoor dew point. Humidifier minutes with no pump runs is what CondensatePumpIdle catches; a dry stretch with neither is HumidifierIdle.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((WITH (p = esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"}) (p > bool 20) * (p < bool 50) + (p > bool 75))[$__interval:15s]) * 60",
          "legendFormat": "humidifier minutes"
        },
        {
          "refId": "C",
          "expr": "sum_over_time(((esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"} > bool 50) > (esphome_sensor_value{job=\"esphome\",host=\"condensate-pump\",id=\"power\"} offset 15s > bool 50))[$__interval:15s])",
          "legendFormat": "pump runs"
        },
        {
          "refId": "B",
          "expr": "WITH (t = weather_temperature_celsius{job=\"birdnet-go\"}, g = ln(weather_humidity_percentage{job=\"birdnet-go\"} / 100) + 17.62 * t / (243.12 + t)) 243.12 * g / (17.62 - g)",
          "legendFormat": "dew point"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pump runs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dew point"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "min"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "1h"
    },
    {
      "type": "row",
      "title": "Outlets",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Energy per Day",
      "description": "kWh each outlet used per day over the last 14 days, from the plug's Total Energy counter, which survives reboots but not a factory reset.",
