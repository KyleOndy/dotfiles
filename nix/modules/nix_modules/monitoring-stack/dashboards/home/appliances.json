    {
      "type": "timeseries",
      "title": "Wi-Fi Signal",
      "description": "Each plug's signal on Ondy's - IOT. The first thing to check when a plug goes offline with its outlet still live.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "esphome_sensor_value{job=\"esphome\",id=\"wifi_signal_db\"}",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
