    {
      "type": "stat",
      "title": "Ratings",
      "description": "What the UPS reports as its nominal ratings, plus the 900 W rating from the SMART1500LCD spec and the delay upsmon gives the UPS between FSD and cutting its outlets.",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "network_ups_tools_ups_power_nominal{host=\"tiger\"}",
          "legendFormat": "apparent",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "vector($ups_watts)",
          "legendFormat": "real",
          "instant": true
        },
        {
          "refId": "C",
