    },
    {
      "type": "table",
      "title": "Top Clients by 5xx",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (client) (count_over_time({job=\"caddy-access\", vhost=~\"$vhost\"} | json client=\"request.client_ip\", status=\"status\" | status >= 500 [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "client": "Client IP",
              "Value": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Who is receiving the errors. Aggregating every request by client IP exceeds Loki max_query_series (5000); scoping to 5xx keeps it bounded."
    },
    {
      "type": "table",
      "title": "Top User Agents",
      "description": "The public aliases are crawled. This is where bot traffic shows up against real use.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (ua) (count_over_time({job=\"caddy-access\", vhost=~\"$vhost\"} | json ua=\"request.headers[\\\"User-Agent\\\"][0]\" [$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ua": "User Agent",
              "Value": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "logs",
      "title": "Recent 5xx",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"caddy-access\", vhost=~\"$vhost\"} | json status=\"status\" | status >= 500",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "DDNS",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Apex Records",
      "description": "ondy.org and kyleondy.com, the only records ddns-route53 holds, against the WAN IP it detected. The updater cannot read Route53 back, so this compares its own record of what it last wrote. *.apps and every other name follow home.1ella.com, which the UniFi console updates.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddns_route53_records_match_wan_ip{host=\"tiger\"}",
          "legendFormat": "Apex records",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "MATCH",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "MISMATCH",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "UniFi Record",
      "description": "The record the UniFi console's own DDNS updates, where every CNAME through tiger.infra.ondy.org ends, resolved through 1.1.1.1 against the same WAN IP. A failed lookup also reads as a mismatch. UnifiDdnsMismatch fires after 30 minutes of it.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddns_unifi_record_matches_wan_ip{host=\"tiger\"}",
          "legendFormat": "{{record}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "MATCH",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "MISMATCH",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "DDNS Last Success",
      "description": "Time since a run last left every apex record on the WAN IP. DdnsStale fires past 30 minutes while the records still read as matching.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - ddns_route53_last_success_timestamp_seconds{host=\"tiger\"}",
          "legendFormat": "Last success",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Record Updates (30d)",
      "description": "UPSERTs Route53 accepted, one per apex record each time the WAN IP changes.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(ddns_route53_record_updates_total{host=\"tiger\"}[30d])",
          "legendFormat": "Updates",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
