      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate({job=\"caddy-access\", vhost=~\"$vhost\"} | json status=\"status\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
