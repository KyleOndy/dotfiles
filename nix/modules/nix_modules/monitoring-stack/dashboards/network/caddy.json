    {
      "type": "timeseries",
      "title": "5xx Rate by Site",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vhost) (rate({job=\"caddy-access\", vhost=~\"$vhost\"} | json status=\"status\" | status >= 500 [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{vhost}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
