      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {job=\"caddy-access\", vhost=~\"$vhost\"} | json dur=\"duration\" | unwrap dur [$__auto]) by (vhost)",
          "queryType": "range",
          "legendFormat": "{{vhost}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
