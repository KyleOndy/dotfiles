{
  "id": null,
  "uid": "cogsworth",
  "title": "Cogsworth",
  "description": "The family calendar kiosk: calendar sync, scheduler tasks, photo index, BirdNET-Go, DB snapshots and Pi health. Investigation surface for the cogsworth_monitoring alert group. Scheduler task names are in `task`, not `job`.",
  "tags": ["application", "cogsworth", "kiosk"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Kiosk",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_systemd_unit_state{host=\"cogsworth\",name=\"cogsworth.service\",state=\"active\"}",
          "legendFormat": "Backend",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "node_systemd_unit_state{host=\"cogsworth\",name=\"cogsworth-kiosk.service\",state=\"active\"}",
          "legendFormat": "Kiosk",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "cogsworth_sse_clients",
          "legendFormat": "SSE clients",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum(increase(node_systemd_service_restart_total{host=\"cogsworth\",name=\"cogsworth.service\"}[24h])) or vector(0)",
          "legendFormat": "Restarts 24h",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Backend|Kiosk" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": { "text": "UP", "color": "green", "index": 0 },
                      "0": { "text": "DOWN", "color": "red", "index": 1 }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Restarts 24h" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 3 },
                    { "color": "red", "value": 10 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Pi Health",
      "description": "CogsworthHighCPUTemp fires at 70C. Idle sits near 63C, so this runs close to the line.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(node_hwmon_temp_celsius{host=\"cogsworth\"})",
          "legendFormat": "CPU temp",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(1 - node_memory_MemAvailable_bytes{host=\"cogsworth\"} / node_memory_MemTotal_bytes{host=\"cogsworth\"}) * 100",
          "legendFormat": "Memory",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "cogsworth_jvm_heap_used_bytes",
          "legendFormat": "JVM heap",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "cogsworth_process_resident_memory_bytes",
          "legendFormat": "Process RSS",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU temp" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 65 },
                    { "color": "red", "value": 70 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [
              { "id": "unit", "value": "percent" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 80 },
                    { "color": "red", "value": 90 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "JVM heap|Process RSS" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Calendars",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Calendar Sync",
      "description": "1 means the last webcal fetch succeeded. A dead iCloud share URL returns 404 and pins this at 0 while the kiosk keeps serving cached events.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "cogsworth_calendar_sync_ok",
          "legendFormat": "{{calendar_id}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "OK", "color": "green", "index": 0 },
                "0": { "text": "FAILING", "color": "red", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Events Cached",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "cogsworth_calendar_events",
          "legendFormat": "{{calendar_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Scheduler",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Task Freshness",
      "description": "Time since each scheduler task last completed. The loops run every few minutes and go red at an hour, which is CogsworthJobStalled. The syncs and cleanups run daily and go yellow once a day has passed; the alert covers only immich-sync and gphotos-sync.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - cogsworth_job_last_success_timestamp_seconds",
          "legendFormat": "{{task}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 600 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "immich-sync|gphotos-sync|bird-art-sync|.*-cleanup|.*-sweep"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 86400 },
                    { "color": "red", "value": 90000 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Task Freshness Over Time",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - cogsworth_job_last_success_timestamp_seconds",
          "legendFormat": "{{task}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "scaleDistribution": { "type": "log", "log": 10 },
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Photos and Display",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Screensaver Photos Indexed",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "cogsworth_screensaver_photos",
          "legendFormat": "Photos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "min"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Album Sync Failures",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(cogsworth_photo_album_sync_failures_total[1h])",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Display Power Failures",
      "description": "Failed attempts to drive DPMS. A rising count means the panel is not responding to sleep or wake.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(cogsworth_dpms_apply_failures_total[1h])",
          "legendFormat": "DPMS failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "row",
      "title": "Birds",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Audio Analysed",
      "description": "BirdNET analysis windows per 5 minutes, all streams together. Each camera stream adds about 200, so a drop to half means one stream's audio is gone; birdnet-go exports nothing per stream. Zero for 30 minutes fires CogsworthBirdnetNoAudio.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(birdnet_predictions_total{host=\"cogsworth\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "min"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Detections",
      "description": "Approved detections per hour. A day of none while audio is flowing fires CogsworthBirdnetNoDetections.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(birdnet_detections{host=\"cogsworth\"}[1h]))",
          "legendFormat": "Detections per hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Processing Errors",
      "description": "Failed inferences by error type, and audio chunks the pipeline dropped because analysis fell behind, per source ID. Both series are absent until the first one happens.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (increase(birdnet_prediction_errors_total{host=\"cogsworth\"}[1h]))",
          "legendFormat": "inference {{error_type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (source) (increase(birdnet_audio_dropped_chunks{host=\"cogsworth\"}[1h]))",
          "legendFormat": "dropped {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Audio Analysed per Stream",
      "description": "BirdNET analysis windows per 5 minutes for each camera stream, about 200 when healthy. Read from the pipeline stats line birdnet-go logs every 5 minutes for each stream that analysed any audio, so a stream delivering nothing breaks off rather than dropping to zero; 30 minutes of that fires CogsworthBirdnetStreamSilent. A stream with no name in the birdnet-go config shows as unnamed, since its source would otherwise be its stream URL.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "loki", "uid": "loki" },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (sum_over_time({host=\"cogsworth\",unit=\"birdnet-go.service\"} |= \"operation=pipeline_stats_report\" | logfmt | label_format source=`{{ if contains \"://\" .source }}unnamed{{ else }}{{ .source }}{{ end }}` | unwrap inferences [5m]))",
          "legendFormat": "{{source}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["last", "min"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "row",
      "title": "Database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "DB Snapshot",
      "description": "Time since cogsworth-db-snapshot last copied the tmpfs DB to the SD card, and the size of that copy. The timer runs every 5 minutes; CogsworthDbSnapshotStale fires at 15. The live DB and its WAL share a 16 MiB tmpfs, so Size turns red at 15 MiB.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - cogsworth_db_snapshot_last_success_timestamp_seconds{host=\"cogsworth\"}",
          "legendFormat": "Age",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "cogsworth_db_snapshot_size_bytes{host=\"cogsworth\"}",
          "legendFormat": "Size",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Age" },
            "properties": [
              { "id": "unit", "value": "s" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 600 },
                    { "color": "red", "value": 900 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Size" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 12582912 },
                    { "color": "red", "value": 15728640 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Backend Errors",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 48 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=\"cogsworth\",unit=~\"cogsworth.service|cogsworth-kiosk.service\"} |~ \"(?i)(error|fatal|task-failed)\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
