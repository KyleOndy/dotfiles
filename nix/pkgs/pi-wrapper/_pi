#compdef pi
_arguments -s \
  '--session-help[show session and grant options]' \
  '--resume-session[resume with recorded authority]:session ID:' \
  '--export-session[verify and export committed changes]:session ID:' \
  '--inspect-session[show recorded authority]:session ID:' \
  '--list-sessions[list retained sessions]' \
  '--coordinator[start or reconnect a persistent coordinator]::coordinator ID:' \
  '--start-coordinator[start the coordinator without opening the UI]' \
  '--web[allow public internet destinations]' \
  '*--allow[allow one network destination]:host:' \
  '*--listen[allow one local preview port]:port:' \
  '*--allow-read[grant filesystem read]:path:_files' \
  '*--allow-write[grant filesystem write]:path:_files' \
  '*--allow-rw[grant filesystem read and write]:path:_files' \
  '--allow-nix[use the configured isolated Nix builder]' \
  '--allow-git-write[allow commits in private Git storage]' \
  '--no-git-write[deny changes to private Git storage]' \
  '--allow-trustd[permit Apple certificate validation services]' \
  '--allow-forge[authorize optional Forge resources for children]' \
  '--allow-clipboard[permit clipboard access]' \
@bundleFlags@  '*:pi argument:_files'
