#!/usr/bin/env bash

# Source common library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/common.sh"

set_strict_mode

show_help() {
	cat <<'EOF'
usage: git claim [options] [base]

Rewrite the author of commits somebody else made on this branch to you.

Agents commit under their own identity: the pi wrapper exports
GIT_AUTHOR_NAME and GIT_AUTHOR_EMAIL as an `ai-daemon@` address, and forge
does the same, so `git log` shows which commits came out of an agent. Claiming
them says you are answering for the work as its author.

  git claim
    → base: merge-base of HEAD and the local default branch
    → re-authors every commit in base..HEAD not already authored by you

  git claim main
    → same, against an explicit base

Options:
  -n, --dry-run   List what would be re-authored and stop
  -y, --yes       Skip the confirmation prompt
  -h, --help      Show this help

Author dates are preserved: `--author` changes the identity, where
`--reset-author` would also stamp the date as now and lose when the work
actually happened.

Signatures are a separate question. Rewriting a commit re-signs it or not
according to this repository's commit.gpgsign, so run `git adopt` afterwards
to sign the range deliberately.

Refuses to run under the same conditions as `git adopt`: uncommitted changes
to tracked files, a detached HEAD, or any commit in the range already on a
remote. A range you already authored is reported and left alone.
EOF
	exit 0
}

dry_run=false
assume_yes=false
base_arg=""

while [[ $# -gt 0 ]]; do
	case $1 in
	-n | --dry-run)
		dry_run=true
		shift
		;;
	-y | --yes)
		assume_yes=true
		shift
		;;
	-h | --help)
		show_help
		;;
	-*)
		die "Unknown option $1. Use --help for usage."
		;;
	*)
		[[ -z $base_arg ]] || die "Only one base may be given, got '${base_arg}' and '$1'"
		base_arg=$1
		shift
		;;
	esac
done

base=$(require_rewritable_range "$base_arg")
branch=$(git rev-parse --abbrev-ref HEAD)

me_name=$(git config user.name) || die "user.name is not configured"
me_email=$(git config user.email) || die "user.email is not configured"
[[ -n $me_name && -n $me_email ]] || die "user.name and user.email must both be set"

total=$(git rev-list --count "${base}..HEAD")
if [[ $total -eq 0 ]]; then
	log_info "Nothing to claim: ${branch} adds no commits over its base"
	exit 0
fi

foreign=$(git log --format='%ae' "${base}..HEAD" | grep -c -v -x -F "$me_email" || true)
if [[ $foreign -eq 0 ]]; then
	log_info "Already yours: all ${total} commit(s) are authored by ${me_email}"
	exit 0
fi

echo "Commits to claim on ${branch}:" >&2
echo "" >&2
git log --format='  %h %<(30,trunc)%an <%ae> %s' "${base}..HEAD" >&2
echo "" >&2

if [[ $dry_run == true ]]; then
	log_info "Dry run: nothing was rewritten"
	exit 0
fi

if [[ $assume_yes != true ]]; then
	read -r -p "Re-author ${foreign} of ${total} commit(s) as ${me_name} <${me_email}>? [y/N] " -n 1
	echo "" >&2
	[[ $REPLY =~ ^[Yy]$ ]] || die "Cancelled"
fi

# Exported rather than interpolated so the --exec string needs no quoting, and
# read at replay time by the shell git spawns per commit. The test skips
# commits already yours, so rebase does not amend what it does not need to.
export GIT_CLAIM_EMAIL="$me_email"
export GIT_CLAIM_AUTHOR="${me_name} <${me_email}>"

log_info "Re-authoring ${foreign} of ${total} commit(s)..."
# shellcheck disable=SC2016 # the shell git spawns per commit does the expanding
git rebase --force-rebase --exec \
	'test "$(git log -1 --format=%ae)" = "$GIT_CLAIM_EMAIL" || git commit --amend --no-edit --author="$GIT_CLAIM_AUTHOR"' \
	"$base"

echo "" >&2
log_info "Claimed:"
git log --format='  %h %<(30,trunc)%an <%ae> %s' "${base}..HEAD" >&2
